</audio>  <script>  
  
/* =========================  
   ESTRELLAS  
========================= */  
  
const stars = document.getElementById("stars");  
  
for(let i=0;i<700;i++){  
  
    const star = document.createElement("div");  
  
    star.className = "star";  
  
    star.style.left = Math.random()*100 + "%";  
    star.style.top = Math.random()*100 + "%";  
  
    star.style.animationDelay =  
        Math.random()*4 + "s";  
  
    star.style.animationDuration =  
        2 + Math.random()*4 + "s";  
  
    stars.appendChild(star);  
}  
  
  
/* =========================  
   PARTICULAS  
========================= */  
  
const particles =  
document.getElementById("particles");  
  
for(let i=0;i<35;i++){  
  
    const particle =  
    document.createElement("div");  
  
    particle.className="particle";  
  
    particle.style.left =  
        Math.random()*100 + "%";  
  
    particle.style.animationDelay =  
        Math.random()*10 + "s";  
  
    particle.style.animationDuration =  
        8 + Math.random()*12 + "s";  
  
    particles.appendChild(particle);  
}  
  
  
/* =========================  
   ENTRAR  
========================= */  
  
function enterPage(){  
  
    const intro =  
    document.getElementById("intro");  
  
    intro.classList.add("hidden");  
  
    const music =  
    document.getElementById("music");  
  
    music.volume=.25;  
  
    music.play().catch(()=>{});  
  
    setTimeout(()=>{  
  
        window.scrollTo({  
            top:0,  
            behavior:"smooth"  
        });  
  
    },500);  
}  
  
  
/* =========================  
   REVEAL AL HACER SCROLL  
========================= */  
  
const observer =  
new IntersectionObserver(  
(entries)=>{  
  
    entries.forEach(entry=>{  
  
        if(entry.isIntersecting){  
  
            entry.target.classList.add("visible");  
  
        }  
  
    });  
  
},  
{  
    threshold:.15  
});  
  
  
document  
.querySelectorAll(".reveal")  
.forEach(el=>observer.observe(el));  
  
  
/* =========================  
   TULIPANES  
========================= */  
  
function showMessage(text){  
  
    document  
    .getElementById("messageText")  
    .textContent=text;  
  
    document  
    .getElementById("tulipMessage")  
    .classList.add("show");  
  
}  
  
function closeMessage(){  
  
    document  
    .getElementById("tulipMessage")  
    .classList.remove("show");  
  
}  
  
  
/* =========================  
   PUERTA  
========================= */  
  
let doorOpened=false;  
  
function openDoor(){  
  
    const door=  
    document.getElementById("door");  
  
    if(!doorOpened){  
  
        door.classList.add("open");  
  
        doorOpened=true;  
  
        setTimeout(()=>{  
  
            door.scrollIntoView({  
                behavior:"smooth",  
                block:"center"  
            });  
  
        },1000);  
  
    }  
  
}  
  
  
/* =========================  
   RESPUESTA FINAL  
========================= */  
  
function answerYes(){  
  
    const response =  
    document.getElementById("response");  
  
    response.innerHTML =  
    "Entonces caminemos. Sin prisa. Sin miedo. Juntos.";  
  
    createFinalStars();  
  
}  
  
  
function answerMaybe(){  
  
    const response =  
    document.getElementById("response");  
  
    response.innerHTML =  
    "Está bien. No necesitas responder ahora. Tómate tu tiempo.";  
  
}  
  
  
/* =========================  
   ESTRELLAS FINALES  
========================= */  
  
function createFinalStars(){  
  
    for(let i=0;i<200;i++){  
  
        const star =  
        document.createElement("div");  
  
        star.className="star";  
  
        star.style.position="fixed";  
  
        star.style.left=  
            Math.random()*100+"vw";  
  
        star.style.top=  
            Math.random()*100+"vh";  
  
        star.style.zIndex="50";  
  
        star.style.pointerEvents="none";  
  
        document.body.appendChild(star);  
  
        setTimeout(()=>{  
  
            star.remove();  
  
        },5000);  
  
    }  
  
}  
  
  
/* =========================  
   CERRAR MODAL  
========================= */  
  
document  
.getElementById("tulipMessage")  
.addEventListener("click",function(e){  
  
    if(e.target===this){  
  
        closeMessage();  
  
    }  
  
});  
  

/* =========================
   INTERACTIVIDAD AÑADIDA
========================= */

function toggleMusic(){
    const music=document.getElementById("music");
    const button=document.getElementById("musicButton");
    if(!music) return;
    if(music.paused){
        music.play().catch(()=>{});
        if(button) button.textContent="♫";
    }else{
        music.pause();
        if(button) button.textContent="🔇";
    }
}

function openFinalModal(){
    const modal=document.getElementById("finalModal");
    if(modal) modal.style.display="flex";
}

function closeModal(){
    const modal=document.getElementById("finalModal");
    if(modal) modal.style.display="none";
}

/* Tarjetas: interacción tipo memoria del segundo HTML */
document.querySelectorAll(".card").forEach(card=>{
    card.addEventListener("click",()=>{
        card.classList.toggle("flipped");
    });
});

/* Barra de progreso */
window.addEventListener("scroll",()=>{
    const total=document.documentElement.scrollHeight-window.innerHeight;
    const amount=total>0 ? (window.scrollY/total)*100 : 0;
    const progress=document.getElementById("progress");
    if(progress) progress.style.width=amount+"%";
});

/* Brillo que sigue el cursor */
document.addEventListener("pointermove",e=>{
    const glow=document.getElementById("cursorGlow");
    if(glow){
        glow.style.left=e.clientX+"px";
        glow.style.top=e.clientY+"px";
    }
});

/* Cerrar modal tocando fuera */
document.getElementById("finalModal")?.addEventListener("click",function(e){
    if(e.target===this) closeModal();
});

</script>  
