}

.heart{  
    font-size:75px;  
    transition:.5s;  
  
    filter:  
        drop-shadow(0 0 15px rgba(96,165,250,.7));  
}

.choice-area{  
    text-align:center;  
    margin-top:80px;  
}

.choice-btn{  
    margin:10px;  
    padding:16px 35px;  
  
    border-radius:50px;  
  
    border:1px solid rgba(147,197,253,.4);  
  
    background:rgba(30,64,175,.2);  
  
    color:white;  
  
    cursor:pointer;  
  
    font-size:16px;  
  
    transition:.4s;  
}

.choice-btn:hover{  
    background:#2563eb;  
    transform:translateY(-4px);  
  
    box-shadow:  
        0 10px 30px rgba(37,99,235,.4);  
}

.choice-message{  
    margin-top:30px;  
    min-height:30px;  
    color:#bfdbfe;  
}

.modal{  
    position:fixed;  
    inset:0;  
  
    display:flex;  
    justify-content:center;  
    align-items:center;  
  
    background:rgba(2,6,23,.8);  
  
    backdrop-filter:blur(15px);  
  
    z-index:80;  
  
    opacity:0;  
    visibility:hidden;  
  
    transition:.5s;  
}

.modal-box{  
    width:min(600px,90%);  
    padding:45px;  
  
    border-radius:30px;  
  
    background:  
        linear-gradient(  
            145deg,  
            rgba(30,64,175,.5),  
            rgba(15,23,42,.8)  
        );  
  
    border:1px solid rgba(147,197,253,.3);  
  
    text-align:center;  
  
    transform:scale(.8);  
