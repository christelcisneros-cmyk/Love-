<!DOCTYPE html>  <html lang="es">  
<head>  
<meta charset="UTF-8">  
<meta name="viewport" content="width=device-width, initial-scale=1.0">  
<title>Siempre fuiste tú</title>  <style>  
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Montserrat:wght@300;400;500&display=swap');  
  
*{  
    box-sizing:border-box;  
    margin:0;  
    padding:0;  
}  
  
html{  
    scroll-behavior:smooth;  
}  
  
body{  
    background:#02040d;  
    color:#f4f6ff;  
    font-family:"Cormorant Garamond",serif;  
    overflow-x:hidden;  
}  
  
/* =========================  
   FONDO  
========================= */  
  
#stars{  
    position:fixed;  
    inset:0;  
    z-index:-5;  
    background:  
        radial-gradient(circle at 50% 45%,rgba(42,73,170,.25),transparent 30%),  
        radial-gradient(circle at 20% 20%,rgba(50,70,160,.12),transparent 30%),  
        linear-gradient(#01030a,#050a1c 50%,#010209);  
}  
  
.star{  
    position:absolute;  
    width:2px;  
    height:2px;  
    background:white;  
    border-radius:50%;  
    opacity:.7;  
    animation:twinkle 3s infinite ease-in-out;  
}  
  
@keyframes twinkle{  
    0%,100%{opacity:.2;transform:scale(.7)}  
    50%{opacity:1;transform:scale(1.5)}  
}  
  
/* =========================  
   PARTICULAS  
========================= */  
  
.particle{  
    position:fixed;  
    width:3px;  
    height:3px;  
    border-radius:50%;  
    background:#9ebcff;  
    opacity:.4;  
    pointer-events:none;  
    animation:float 12s linear infinite;  
}  
  
@keyframes float{  
    from{  
        transform:translateY(110vh) translateX(0);  
        opacity:0;  
    }  
    20%{opacity:.5}  
    80%{opacity:.3}  
    to{  
        transform:translateY(-10vh) translateX(80px);  
        opacity:0;  
    }  
}  
  
/* =========================  
   INTRO  
========================= */  
  
#intro{  
    position:fixed;  
    inset:0;  
    z-index:100;  
    display:flex;  
    justify-content:center;  
    align-items:center;  
    text-align:center;  
    background:  
        radial-gradient(circle at center,rgba(24,47,117,.35),transparent 40%),  
        #01020a;  
    transition:opacity 1.5s ease,visibility 1.5s ease;  
}  
  
#intro.hidden{  
    opacity:0;  
    visibility:hidden;  
    pointer-events:none;  
}  
  
.intro-content{  
    width:min(700px,90%);  
    animation:appear 2s ease;  
}  
  
.small-intro{  
    font-family:Montserrat,sans-serif;  
    text-transform:uppercase;  
    letter-spacing:5px;  
    font-size:11px;  
    color:#9ebcff;  
    margin-bottom:30px;  
}  
  
.intro-title{  
    font-size:clamp(45px,9vw,90px);  
    font-weight:500;  
    line-height:.9;  
    margin-bottom:30px;  
}  
  
.intro-subtitle{  
    font-size:21px;  
    line-height:1.7;  
    color:#cdd5ec;  
    margin-bottom:45px;  
}  
  
.enter{  
    border:1px solid rgba(170,195,255,.5);  
    background:rgba(20,35,85,.25);  
    color:white;  
    padding:15px 45px;  
    border-radius:50px;  
    font-family:Montserrat,sans-serif;  
    letter-spacing:3px;  
    text-transform:uppercase;  
    cursor:pointer;  
    transition:.5s;  
}  
  
.enter:hover{  
    background:#dfe8ff;  
    color:#060918;  
    box-shadow:0 0 40px rgba(110,150,255,.5);  
    transform:translateY(-3px);  
}  
  
@keyframes appear{  
    from{  
        opacity:0;  
        transform:translateY(30px);  
    }  
    to{  
        opacity:1;  
        transform:none;  
    }  
}  
  
/* =========================  
   HEADER  
========================= */  
  
header{  
    min-height:100vh;  
    display:flex;  
    justify-content:center;  
    align-items:center;  
    text-align:center;  
    padding:40px 20px;  
    position:relative;  
}  
  
.moon{  
    position:absolute;  
    width:230px;  
    height:230px;  
    border-radius:50%;  
    background:  
        radial-gradient(circle at 35% 30%,#fff,#dce7ff 45%,#8fa9dd);  
    box-shadow:  
        0 0 30px #a8c2ff,  
        0 0 100px rgba(94,133,255,.5),  
        0 0 180px rgba(72,101,255,.25);  
    opacity:.9;  
    animation:moonFloat 6s ease-in-out infinite;  
}  
  
@keyframes moonFloat{  
    0%,100%{transform:translateY(0)}  
    50%{transform:translateY(-12px)}  
}  
  
.hero{  
    position:relative;  
    z-index:2;  
    max-width:900px;  
}  
  
.hero-label{  
    font-family:Montserrat,sans-serif;  
    color:#9dbaff;  
    font-size:11px;  
    letter-spacing:7px;  
    text-transform:uppercase;  
    margin-bottom:35px;  
}  
  
.hero h1{  
    font-size:clamp(60px,12vw,145px);  
    line-height:.8;  
    font-weight:500;  
    text-shadow:0 0 35px rgba(120,155,255,.3);  
}  
  
.hero p{  
    max-width:650px;  
    margin:45px auto 0;  
    font-size:22px;  
    color:#ccd5ed;  
    line-height:1.7;  
}  
  
.scroll{  
    position:absolute;  
    bottom:30px;  
    left:50%;  
    transform:translateX(-50%);  
    font-family:Montserrat,sans-serif;  
    font-size:9px;  
    letter-spacing:4px;  
    color:#7180a6;  
}  
  
/* =========================  
   CAPITULOS  
========================= */  
  
.chapter{  
    min-height:100vh;  
    display:flex;  
    align-items:center;  
    justify-content:center;  
    padding:100px 20px;  
    position:relative;  
}  
  
.chapter-inner{  
    width:min(850px,100%);  
}  
  
.chapter-number{  
    font-family:Montserrat,sans-serif;  
    font-size:10px;  
    letter-spacing:5px;  
    color:#7194e8;  
    margin-bottom:20px;  
    text-transform:uppercase;  
}  
  
.chapter-title{  
    font-size:clamp(42px,7vw,80px);  
    line-height:1;  
    font-weight:500;  
    margin-bottom:40px;  
}  
  
.text{  
    font-size:clamp(20px,2.2vw,25px);  
    line-height:1.9;  
    color:#d9def0;  
}  
  
.text p{  
    margin-bottom:35px;  
}  
  
.highlight{  
    color:#a9c4ff;  
    font-size:1.15em;  
}  
  
.quote{  
    border-left:1px solid #7096ed;  
    padding:25px 30px;  
    margin:50px 0;  
    color:#eaf0ff;  
    font-size:clamp(25px,4vw,40px);  
    font-style:italic;  
}  
  
/* =========================  
   TARJETAS  
========================= */  
  
.cards{  
    display:grid;  
    grid-template-columns:repeat(auto-fit,minmax(180px,1fr));  
    gap:15px;  
    margin-top:50px;  
}  
  
.card{  
    min-height:150px;  
    border:1px solid rgba(125,155,225,.18);  
    background:rgba(20,30,65,.18);  
    backdrop-filter:blur(10px);  
    padding:25px;  
    display:flex;  
    align-items:flex-end;  
    border-radius:15px;  
    transition:.5s;  
}  
  
.card:hover{  
    transform:translateY(-8px);  
    border-color:rgba(145,177,255,.55);  
    box-shadow:0 15px 50px rgba(40,75,160,.2);  
}  
  
.card span{  
    font-size:25px;  
}  
  
/* =========================  
   GALAXIA  
========================= */  
  
.galaxy-section{  
    min-height:100vh;  
    display:flex;  
    align-items:center;  
    justify-content:center;  
    text-align:center;  
    position:relative;  
    overflow:hidden;  
    padding:80px 20px;  
}  
  
.galaxy{  
    position:absolute;  
    width:min(900px,100vw);  
    height:min(900px,100vw);  
    border-radius:50%;  
    opacity:.6;  
}  
  
.galaxy::before,  
.galaxy::after{  
    content:"";  
    position:absolute;  
    inset:10%;  
    border:1px solid rgba(100,145,255,.15);  
    border-radius:50%;  
    transform:rotate(25deg) scaleX(2.3);  
}  
  
.galaxy::after{  
    transform:rotate(-25deg) scaleX(2.3);  
}  
  
.galaxy-core{  
    position:absolute;  
    left:50%;  
    top:50%;  
    transform:translate(-50%,-50%);  
    width:100px;  
    height:100px;  
    border-radius:50%;  
    background:#dce8ff;  
    box-shadow:  
        0 0 30px #9ebcff,  
        0 0 100px #547eea,  
        0 0 180px rgba(75,110,255,.4);  
}  
  
.galaxy-content{  
    position:relative;  
    z-index:3;  
    max-width:700px;  
}  
  
.galaxy-content h2{  
    font-size:clamp(45px,8vw,90px);  
    font-weight:500;  
}  
  
.galaxy-content p{  
    font-size:22px;  
    line-height:1.8;  
    color:#cbd4ec;  
    margin-top:30px;  
}  
  
/* =========================  
   TULIPANES  
========================= */  
  
.tulips{  
    display:flex;  
    justify-content:center;  
    gap:25px;  
    flex-wrap:wrap;  
    margin:60px 0;  
}  
  
.tulip{  
    width:100px;  
    height:130px;  
    position:relative;  
    cursor:pointer;  
    transition:.5s;  
}  
  
.tulip:hover{  
    transform:translateY(-10px);  
}  
  
.tulip-flower{  
    width:65px;  
    height:70px;  
    background:linear-gradient(135deg,#b8cfff,#637fd0);  
    border-radius:50% 50% 45% 45%;  
    position:absolute;  
    left:18px;  
    top:5px;  
    box-shadow:0 0 25px rgba(105,145,255,.35);  
}  
  
.tulip-stem{  
    position:absolute;  
    width:4px;  
    height:65px;  
    background:#6681c0;  
    left:48px;  
    top:65px;  
}  
  
.tulip-leaf{  
    position:absolute;  
    width:30px;  
    height:15px;  
    border-radius:100% 0;  
    background:#526da5;  
    top:90px;  
    left:27px;  
    transform:rotate(-25deg);  
}  
  
.tulip-message{  
    position:fixed;  
    inset:0;  
    background:rgba(0,0,0,.75);  
    backdrop-filter:blur(10px);  
    display:none;  
    align-items:center;  
    justify-content:center;  
    z-index:80;  
    padding:25px;  
}  
  
.tulip-message.show{  
    display:flex;  
}  
  
.message-box{  
    width:min(600px,100%);  
    background:#071027;  
    border:1px solid rgba(150,180,255,.3);  
    border-radius:20px;  
    padding:50px;  
    text-align:center;  
    box-shadow:0 0 80px rgba(50,90,200,.25);  
}  
  
.message-box p{  
    font-size:28px;  
    line-height:1.6;  
}  
  
.close{  
    margin-top:30px;  
    padding:10px 25px;  
    border-radius:30px;  
    background:transparent;  
    border:1px solid #718ed2;  
    color:white;  
    cursor:pointer;  
}  
  
/* =========================  
   PUERTA  
========================= */  
  
.door-section{  
    min-height:100vh;  
    display:flex;  
    flex-direction:column;  
    justify-content:center;  
    align-items:center;  
    text-align:center;  
    padding:40px 20px;  
}  
  
.door{  
    width:240px;  
    height:400px;  
    background:  
        linear-gradient(90deg,#080d1c,#151f3b,#080d1c);  
    border:3px solid #465b91;  
    border-radius:5px;  
    position:relative;  
    cursor:pointer;  
    box-shadow:  
        0 0 30px rgba(82,119,220,.15),  
        inset 0 0 30px rgba(0,0,0,.5);  
    transition:1s;  
}  
  
.door::before{  
    content:"";  
    position:absolute;  
    width:150px;  
    height:100px;  
    border:1px solid #536ba2;  
    left:42px;  
    top:50px;  
}  
  
.door::after{  
    content:"";  
    position:absolute;  
    width:150px;  
    height:100px;  
    border:1px solid #536ba2;  
    left:42px;  
    bottom:50px;  
}  
  
.knob{  
    position:absolute;  
    right:25px;  
    top:50%;  
    width:12px;  
    height:12px;  
    border-radius:50%;  
    background:#b9caff;  
    box-shadow:0 0 10px #9dbaff;  
}  
  
.door.open{  
    transform:perspective(1000px) rotateY(-65deg);  
    transform-origin:left;  
}  
  
.door-text{  
    max-width:600px;  
    margin-bottom:45px;  
}  
  
.door-text h2{  
    font-size:55px;  
    font-weight:500;  
}  
  
.door-text p{  
    margin-top:20px;  
    color:#aeb9d6;  
    font-size:20px;  
    line-height:1.7;  
}  
  
/* =========================  
   FINAL  
========================= */  
  
.final{  
    min-height:100vh;  
    display:flex;  
    align-items:center;  
    justify-content:center;  
    text-align:center;  
    padding:80px 20px;  
    position:relative;  
}  
  
.final-inner{  
    max-width:900px;  
}  
  
.final-small{  
    font-family:Montserrat,sans-serif;  
    text-transform:uppercase;  
    letter-spacing:5px;  
    color:#819fe8;  
    font-size:10px;  
}  
  
.final h2{  
    font-size:clamp(55px,11vw,130px);  
    line-height:.9;  
    font-weight:500;  
    margin:35px 0;  
}  
  
.final-question{  
    font-size:clamp(25px,4vw,42px);  
    line-height:1.5;  
    color:#dce4f8;  
}  
  
.buttons{  
    display:flex;  
    justify-content:center;  
    gap:15px;  
    flex-wrap:wrap;  
    margin-top:55px;  
}  
  
.final-btn{  
    padding:17px 35px;  
    border-radius:50px;  
    border:1px solid rgba(145,174,245,.5);  
    background:rgba(30,50,110,.2);  
    color:white;  
    cursor:pointer;  
    font-family:Montserrat,sans-serif;  
    transition:.5s;  
}  
  
.final-btn:hover{  
    background:#dce7ff;  
    color:#050816;  
    box-shadow:0 0 40px rgba(130,160,255,.4);  
}  
  
.response{  
    margin-top:45px;  
    font-size:28px;  
    color:#b8cbff;  
    min-height:45px;  
}  
  
/* =========================  
   RESPONSIVE  
========================= */  
  
@media(max-width:600px){  
  
    .moon{  
        width:160px;  
        height:160px;  
    }  
  
    .hero h1{  
        font-size:65px;  
    }  
  
    .hero p{  
        font-size:18px;  
    }  
  
    .chapter{  
        padding:80px 22px;  
    }  
  
    .text{  
        font-size:19px;  
        line-height:1.8;  
    }  
  
    .quote{  
        font-size:27px;  
        padding:20px;  
    }  
  
    .door{  
        width:190px;  
        height:320px;  
    }  
  
    .message-box{  
        padding:30px 20px;  
    }  
  
    .message-box p{  
        font-size:23px;  
    }  
}  
  
/* =========================  
   OCULTAR SECCIONES  
========================= */  
  
.reveal{  
    opacity:0;  
    transform:translateY(50px);  
    transition:1.2s ease;  
}  
  
.reveal.visible{  
    opacity:1;  
    transform:none;  
}  
  

.progress{  
    position:fixed;  
    top:0;  
    left:0;  
    height:3px;  
    width:0%;  
    background:linear-gradient(  
        90deg,  
        #38bdf8,  
        #818cf8,  
        #c084fc  
    );  
    z-index:50;  
    box-shadow:0 0 15px #60a5fa;  
}

.topbar{  
    position:fixed;  
    top:0;  
    left:0;  
    width:100%;  
    padding:18px 25px;  
    display:flex;  
    justify-content:space-between;  
    align-items:center;  
    z-index:20;  
  
    background:linear-gradient(  
        to bottom,  
        rgba(2,6,23,.8),  
        transparent  
    );  
  
    backdrop-filter:blur(5px);  
}

